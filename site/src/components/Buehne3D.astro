---
// 3D-Bühne mit Farbwähler (Artboards „Startseite Desktop/Handy“, hero_stage in gen2.py).
//
// Grundidee: Im HTML steht IMMER die 2D-Grafik aus dem Zeichen-Motor (fertiges SVG).
// Erst im Browser entscheidet pruefen.js, ob 3D erlaubt ist. Nur dann wird three.js
// nachgeladen, und die Leinwand blendet über die 2D-Grafik, sobald das erste Bild steht.
// Gibt 3D unterwegs auf (Kontextverlust, zu langsam), ist die 2D-Grafik einfach wieder da.
//
// Der Zustand steht zum Nachschauen (und für die Tests) auf dem äusseren Element:
//   data-modus = '2d' | 'laedt' | '3d'     data-grund = warum 2D ('reduced-motion', …)
//
//   modell: 'k1' | 'pro'   farbe: Startfarbe   name: Name der Radio-Gruppe
import Buehne from './Buehne.astro';
import GlasChip from './GlasChip.astro';
import Farbwaehler from './Farbwaehler.astro';
import { handy } from '../lib/kiesel-draw/phone.js';
import { MODELLE } from '../data/modelle.js';

const { modell = 'pro', farbe = 'Himmelblau', name = 'buehne-farbe' } = Astro.props;
const modellName = MODELLE[modell].name;
const svg = handy({ ansicht: 'hinten', modell, farbe, drehung: -10, hoehe: null, label: `${modellName} in ${farbe}, Rückseite` });
---
<div class="buehne-3d" data-buehne3d data-modell={modell} data-name={modellName} data-modus="2d">
  <Buehne class="flaeche">
    <div class="bild-2d" data-bild2d set:html={svg} />
    <span class="chip drehen" data-nur3d hidden>
      <GlasChip icon="rotate"><span class="lang">Ziehen zum Drehen</span><span class="kurz">Drehen</span></GlasChip>
    </span>
    <span class="chip modus" data-nur3d hidden aria-hidden="true"><GlasChip>3D</GlasChip></span>
  </Buehne>
  <div class="leiste">
    <Farbwaehler zeile name={name} wert={farbe} legende={`Farbe des ${modellName}`} />
  </div>
</div>

<style>
  .buehne-3d { position: relative; }
  .buehne-3d :global(.flaeche) { height: 420px; }

  /* 2D-Grafik und 3D-Leinwand liegen übereinander und blenden ineinander über */
  .bild-2d { height: 78%; transition: opacity 0.6s; }
  .bild-2d :global(svg) { width: auto; height: 100%; }
  .buehne-3d :global(.leinwand-3d) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s;
    cursor: grab;
  }
  .buehne-3d :global(.leinwand-3d:active) { cursor: grabbing; }
  .buehne-3d :global(.leinwand-3d:focus-visible) { outline-offset: -4px; }
  .buehne-3d[data-modus="3d"] :global(.leinwand-3d) { opacity: 1; }
  .buehne-3d[data-modus="3d"] .bild-2d { opacity: 0; }

  .chip { position: absolute; bottom: var(--space-3); pointer-events: none; }
  .drehen { left: var(--space-3); }
  .modus, .lang { display: none; }

  /* Handy: Farbpunkte unter der Bühne, Name darunter */
  .leiste {
    display: flex;
    justify-content: center;
    margin-top: var(--space-3);
    --fw-richtung: column;
  }

  @media (min-width: 900px) {
    .buehne-3d :global(.flaeche) { height: clamp(420px, 46vw, 660px); }
    .bild-2d { height: 85%; }
    .chip { bottom: var(--space-5); }
    .drehen { left: var(--space-5); }
    .modus { display: block; right: var(--space-5); }
    .lang { display: inline; }
    .kurz { display: none; }
    /* Desktop: Farbwähler als Glas-Pille unten in der Mitte der Bühne */
    .leiste {
      position: absolute;
      bottom: var(--space-5);
      left: 50%;
      transform: translateX(-50%);
      margin: 0;
      padding: 6px var(--space-4) 6px 6px;
      border-radius: var(--radius-full);
      background: var(--glass);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
      --fw-richtung: row;
      --fw-ink: var(--glass-ink);
      --fw-hover: rgba(255, 255, 255, 0.35);
    }
  }
  /* hidden gewinnt immer (global.css), die Chips erscheinen erst mit 3D */
</style>

<script>
  import { handy } from '../lib/kiesel-draw/phone.js';
  import { grundGegen3D, TESTMODUS } from '../lib/kiesel-3d/pruefen.js';

  const WENIGER_BEWEGUNG = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll('[data-buehne3d]').forEach((el) => {
    const modell = el.dataset.modell;
    const modellName = el.dataset.name;
    const flaeche = el.querySelector('.flaeche');
    const bild2d = el.querySelector('[data-bild2d]');
    let farbe = el.querySelector('input[type="radio"]:checked')?.value ?? 'Himmelblau';
    let b3d = null;

    const label = () => `${modellName} in ${farbe}`;

    // 2D: bei jeder Farbwahl im Browser neu zeichnen (derselbe Zeichen-Motor wie im Build),
    // auch während 3D läuft. So stimmt die Farbe, falls 3D aufgibt.
    el.addEventListener('kiesel:farbe', (e) => {
      farbe = e.detail.farbe;
      bild2d.innerHTML = handy({ ansicht: 'hinten', modell, farbe, drehung: -10, hoehe: null, label: `${label()}, Rückseite` });
      if (b3d) {
        b3d.setzeFarbe(farbe);
        b3d.setzeLabel(`${label()}, 3D-Modell. Mit Maus, Finger oder Pfeiltasten drehen.`);
      }
    });

    const nur3d = (an) => el.querySelectorAll('[data-nur3d]').forEach((c) => { c.hidden = !an; });

    function auf2D(grund) {
      b3d = null;
      el.dataset.modus = '2d';
      el.dataset.grund = grund;
      nur3d(false);
      bild2d.removeAttribute('aria-hidden');
    }

    async function los() {
      el.dataset.modus = 'laedt';
      try {
        // import() mit Pfad: Vite macht daraus eine eigene Datei (samt three.js),
        // die erst jetzt über das Netz kommt.
        const { starte3D } = await import('../lib/kiesel-3d/buehne.js');
        const b = await starte3D({
          ziel: flaeche, modell, farbe, beiAbbruch: auf2D, waechter: TESTMODUS !== 'foto',
          label: `${label()}, 3D-Modell. Mit Maus, Finger oder Pfeiltasten drehen.`,
        });
        if (!b || el.dataset.modus === '2d') return; // unterwegs abgebrochen
        b3d = b;
        // Farbe könnte sich während des Ladens geändert haben
        b3d.setzeFarbe(farbe);
        el.dataset.modus = '3d';
        delete el.dataset.grund;
        nur3d(true);
        // Die 2D-Grafik ist jetzt nur noch durchsichtig: für Screenreader ausblenden,
        // sonst hören sie das Handy doppelt (einmal 2D, einmal die 3D-Leinwand)
        bild2d.setAttribute('aria-hidden', 'true');
      } catch (fehler) {
        console.warn('3D nicht verfügbar, zeige 2D:', fehler);
        auf2D('fehler');
      }
    }

    const grund = grundGegen3D();
    if (grund) { auf2D(grund); return; }

    // Wer während des Besuchs "weniger Bewegung" einschaltet, bekommt sofort 2D
    WENIGER_BEWEGUNG.addEventListener('change', (e) => { if (e.matches && b3d) b3d.beenden('reduced-motion'); });

    // Erst laden, wenn die Seite fertig ist (Text, Bilder und Schriften haben Vorrang),
    // der Browser gerade nichts Wichtigeres zu tun hat (requestIdleCallback, höchstens 2 s
    // warten) und die Bühne in der Nähe des sichtbaren Bereichs liegt.
    // (Safari kennt requestIdleCallback noch nicht, dort nach 200 ms)
    const imLeerlauf = window.requestIdleCallback?.bind(window) ?? ((f) => setTimeout(f, 200));
    const bereit = () => imLeerlauf(() => {
      const beobachter = new IntersectionObserver((eintraege) => {
        if (!eintraege.some((e) => e.isIntersecting)) return;
        beobachter.disconnect();
        los();
      }, { rootMargin: '200px' });
      beobachter.observe(el);
    }, { timeout: 2000 });
    if (document.readyState === 'complete') bereit();
    else addEventListener('load', bereit, { once: true });
  });
</script>
