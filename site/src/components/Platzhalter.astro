---
// Platzhalter für Seiten, deren Inhalt in einer späteren Etappe kommt.
//   etappe: Nummer der Etappe, in der der Inhalt kommt
//   titel:  Überschrift der Seite (h1)
//   einleitung: ein Satz, worum es auf der Seite gehen wird
//   auch:   weitere Etappen, die hier etwas beitragen, z.B. [5] für Kamera-Demos
//   anker:  Sprungziele, die schon verlinkt sind (z.B. "akku" für /kiesel-1/#akku)
import { ETAPPEN } from '../data/navigation.js';

const { etappe, titel, einleitung, auch = [], anker = [] } = Astro.props;
---
<section class="platzhalter container">
  <h1 class="t-1">{titel}</h1>
  {einleitung && <p class="t-lead t-muted einleitung">{einleitung}</p>}

  <div class="karte">
    <p class="etappe">Inhalt folgt in Etappe {etappe}</p>
    <p class="t-muted">{ETAPPEN[etappe]}</p>
    {auch.length > 0 && (
      <ul role="list" class="auch">
        {auch.map((n) => <li>Dazu Etappe {n}: {ETAPPEN[n]}</li>)}
      </ul>
    )}
    <slot />
  </div>

  {anker.map((a) => <div id={a.id} class="anker"><p class="t-small t-muted">{a.text}</p></div>)}
</section>

<style>
  .platzhalter { padding-top: clamp(var(--space-6), 6vw, 88px); }
  .einleitung { max-width: 680px; margin-top: var(--space-4); }
  .karte {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-7);
    padding: var(--space-7) var(--space-6);
    border: 1px dashed var(--line);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--stage), var(--stage-lo));
    text-align: center;
  }
  .etappe {
    font-family: var(--display);
    font-size: var(--fs-3);
    font-weight: 600;
    line-height: var(--lh-3);
    letter-spacing: var(--ls-3);
  }
  .auch { margin: var(--space-2) 0 0; color: var(--muted); font-size: var(--fs-small); }
  .anker {
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px dashed var(--line);
    border-radius: var(--radius-l);
  }
</style>
