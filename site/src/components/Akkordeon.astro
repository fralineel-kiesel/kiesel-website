---
// Akkordeon (Artboard „Startseite Desktop“ › Häufige Fragen): Frage anklicken, Antwort klappt auf.
//   eintraege: [{ id, frage, antwort }]   offen: id des anfangs offenen Eintrags (oder null)
//   ebene:     Überschriften-Ebene der Fragen (3 = <h3>, passend unter einer <h2>)
//
// Warum ein <button> in einer Überschrift und nicht <details>/<summary>?
//   Der Button bringt Enter und Leertaste von selbst mit, und aria-expanded sagt dem
//   Screenreader ausdrücklich „ausgeklappt“ oder „eingeklappt“. Die Überschrift drumherum
//   sorgt dafür, dass man mit der Überschriften-Navigation von Frage zu Frage springen kann.
//   aria-controls verbindet den Button mit seiner Antwort.
import Icon from './Icon.astro';

const { eintraege, offen = null, ebene = 3, idVorsilbe = 'akk' } = Astro.props;
const H = `h${ebene}`;
---
<div class="akkordeon" data-akkordeon>
  {eintraege.map((e) => {
    const auf = e.id === offen;
    return (
      <div class="eintrag">
        <H class="frage">
          <button type="button" class="t-4" id={`${idVorsilbe}-${e.id}-knopf`} aria-expanded={auf ? 'true' : 'false'} aria-controls={`${idVorsilbe}-${e.id}`}>
            <span>{e.frage}</span>
            <Icon name="plus" size={22} class="plus" />
            <Icon name="minus" size={22} class="minus" />
          </button>
        </H>
        <div class="antwort" id={`${idVorsilbe}-${e.id}`} role="region" aria-labelledby={`${idVorsilbe}-${e.id}-knopf`} hidden={!auf}>
          <p>{e.antwort}</p>
        </div>
      </div>
    );
  })}
</div>

<style>
  .akkordeon { display: flex; flex-direction: column; }
  .eintrag { border-top: 1px solid var(--line); }
  .eintrag:last-child { border-bottom: 1px solid var(--line); }
  .frage { font: inherit; }
  button {
    display: flex;
    width: 100%;
    min-height: 44px;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: 22px 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    text-align: left;
  }
  button:hover span { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  /* Zu: Plus, offen: Minus (wie im Artboard) */
  button[aria-expanded="true"] :global(.plus),
  button[aria-expanded="false"] :global(.minus) { display: none; }
  .antwort { padding-bottom: 22px; margin-top: -12px; }
  .antwort p { max-width: 720px; color: var(--muted); }
</style>

<script>
  // Nur aria-expanded und hidden umschalten. Tastatur (Enter/Leertaste) erledigt der Button.
  document.querySelectorAll('[data-akkordeon]').forEach((akk) => {
    akk.addEventListener('click', (e) => {
      const knopf = e.target.closest('button[aria-controls]');
      if (!knopf) return;
      const auf = knopf.getAttribute('aria-expanded') !== 'true';
      knopf.setAttribute('aria-expanded', String(auf));
      document.getElementById(knopf.getAttribute('aria-controls')).hidden = !auf;
    });
  });
</script>
