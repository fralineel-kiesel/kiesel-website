---
// Zähler-Badge (die kleine Zahl in Akzentfarbe, z.B. am Warenkorb).
const { wert = 0, class: klasse, ...rest } = Astro.props;
---
<span class:list={['zaehler', klasse]} {...rest}>{wert}</span>

<style>
  .zaehler {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 11px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--body);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
</style>
