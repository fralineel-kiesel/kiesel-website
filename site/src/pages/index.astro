---
// Startseite (Artboards „Startseite Desktop“ und „Startseite Handy“, gen2.py Abschnitt 1+2).
// Jeder Abschnitt ist ein eigener Baustein in src/components/startseite/.
// Die 3D-Bühne lädt three.js nur hier und nur, wenn das Gerät es verträgt (Buehne3D.astro).
import BaseLayout from '../layouts/BaseLayout.astro';
import Knopf from '../components/Knopf.astro';
import Buehne3D from '../components/Buehne3D.astro';
import Akkordeon from '../components/Akkordeon.astro';
import ModellKarte from '../components/startseite/ModellKarte.astro';
import Kennzahlen from '../components/startseite/Kennzahlen.astro';
import ZoomTeaser from '../components/startseite/ZoomTeaser.astro';
import FunktionsKacheln from '../components/startseite/FunktionsKacheln.astro';
import HuelleTeaser from '../components/startseite/HuelleTeaser.astro';
import { FAQ } from '../data/faq.js';
import { abPreis } from '../data/preise.js';
import { pfad } from '../lib/pfad.js';
---
<BaseLayout>
  <section class="held container" aria-labelledby="titel">
    <h1 class="t-display" id="titel">Passt in jede Hand.</h1>
    <p class="t-lead t-muted einleitung">
      <span class="lang">Kiesel 1 und Kiesel 1 Pro: zwei kompakte Handys, gebaut um einen Akku, der bis in die Nacht hält.</span>
      <span class="kurz">Kiesel 1 und Kiesel 1 Pro: zwei kompakte Handys mit Akku bis in die Nacht.</span>
    </p>
    <div class="knoepfe">
      <Knopf art="primaer" groesse="l" href={pfad('kiesel-1-pro/')}>Kiesel 1 Pro entdecken</Knopf>
      <Knopf art="sekundaer" groesse="l" href={pfad('kaufen/')}>Kaufen {abPreis('k1')}</Knopf>
    </div>
    <div class="buehne">
      <Buehne3D modell="pro" farbe="Himmelblau" name="held-farbe" />
    </div>
  </section>

  <section class="abschnitt container" aria-labelledby="modelle">
    <h2 class="t-1" id="modelle">Welcher Kiesel passt zu dir?</h2>
    <p class="t-lead t-muted unter">Beide im echten Massstab zueinander. Gleiche Farben, gleicher Chip. Der Pro hat mehr Fläche, mehr Akku und eine Tele-Kamera.</p>
    <div class="karten">
      <ModellKarte modell="k1" />
      <ModellKarte modell="pro" />
    </div>
  </section>

  <section class="abschnitt container" aria-label="Kennzahlen">
    <Kennzahlen />
  </section>

  <section class="abschnitt container">
    <ZoomTeaser />
  </section>

  <section class="abschnitt container" aria-labelledby="funktionen">
    <h2 class="t-1" id="funktionen">Kleine Ideen, grosse Wirkung.</h2>
    <FunktionsKacheln />
  </section>

  <section class="abschnitt container">
    <HuelleTeaser />
  </section>

  <section class="abschnitt container" aria-labelledby="fragen">
    <h2 class="t-1" id="fragen">Häufige Fragen</h2>
    <div class="faq">
      <Akkordeon eintraege={FAQ.filter((f) => f.startseite)} offen="kaufen" idVorsilbe="faq" />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Handy (bis 899 px) ── */
  .held { padding-top: var(--space-6); }
  .einleitung { margin-top: var(--space-3); }
  .einleitung .lang { display: none; }
  .knoepfe { display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-5); }
  .knoepfe :global(.knopf) { width: 100%; }
  .buehne { margin-top: var(--space-6); }

  /* Abstand zwischen den Abschnitten: 64 px auf dem Handy bis 140 px auf dem Desktop */
  .abschnitt { padding-top: clamp(var(--space-8), 10vw, var(--space-10)); }
  .unter { max-width: 620px; margin-top: var(--space-4); }
  .karten { display: grid; gap: var(--space-4); margin-top: var(--space-5); }
  .faq { margin-top: var(--space-6); }

  /* ── Desktop (ab 900 px) ── */
  @media (min-width: 900px) {
    .held { padding-top: var(--space-8); text-align: center; }
    .einleitung { max-width: 640px; margin: var(--space-5) auto 0; }
    .einleitung .lang { display: inline; }
    .einleitung .kurz { display: none; }
    .knoepfe { flex-direction: row; justify-content: center; gap: var(--space-3); margin-top: var(--space-6); }
    .knoepfe :global(.knopf) { width: auto; }
    .buehne { margin-top: var(--space-7); text-align: left; }
    .karten { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); margin-top: var(--space-7); }
    .faq { margin-top: calc(var(--space-6) + var(--space-2)); }
  }
</style>
