---
// Hülle-Teaser (Artboard „Startseite Desktop“): Kiesel 1 Pro in Himmelblau mit der
// milchigen Hülle in Mattweiss, leicht gedreht. Das Handy-Artboard hat diesen Abschnitt
// nicht, auf dem Handy steht die Bühne darum einfach über dem Text.
import Buehne from '../Buehne.astro';
import Knopf from '../Knopf.astro';
import { handy } from '../../lib/kiesel-draw/phone.js';
import { HUELLE_PREIS } from '../../data/preise.js';
import { chf } from '../../lib/format.js';
import { pfad } from '../../lib/pfad.js';
import { texte, spracheVon } from '../../i18n/index.js';

const t = texte(spracheVon(Astro.url));
const H = t.startseite.huelle;

const svg = handy({
  ansicht: 'hinten', modell: 'pro', farbe: 'sky-blue', huelle: 'matte-white', drehung: -6, hoehe: null,
  label: H.bild('Kiesel 1 Pro', t.farben['sky-blue'], t.farben['matte-white']),
});
---
<div class="huelle">
  <Buehne radius="l" class="huelle-buehne"><div class="handy" set:html={svg} /></Buehne>
  <div class="text">
    <h2 class="t-1">{H.titel}</h2>
    <p class="t-lead t-muted">{H.text}</p>
    <p class="preis">{chf(HUELLE_PREIS)}</p>
    <div class="knoepfe">
      <Knopf art="sekundaer" href={pfad('zubehoer/')}>{H.zumZubehoer}</Knopf>
      {/* Legt genau die abgebildete Hülle hinein: für den Pro, in Mattweiss */}
      <Knopf art="primaer" data-teaser-huelle data-modell="pro" data-farbe="matte-white"><span data-knopftext>{t.kaufen.inWarenkorb}</span><span class="vh">: {t.warenkorb.huelleFuer('Kiesel 1 Pro', t.farben['matte-white'])}</span></Knopf>
      <p class="vh" aria-live="polite" data-ansage></p>
    </div>
  </div>
</div>

<style>
  .huelle { display: grid; gap: var(--space-6); align-items: center; }
  .huelle :global(.huelle-buehne) { height: 400px; }
  .handy { height: 85%; }
  .handy :global(svg) { width: auto; height: 100%; }
  .text { display: flex; flex-direction: column; gap: var(--space-4); }
  .preis { font-size: var(--fs-3); font-weight: 600; }
  .knoepfe { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  @media (min-width: 900px) {
    .huelle { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); }
    .huelle :global(.huelle-buehne) { height: 520px; }
  }
</style>

<script>
  import { huelleKaufen } from '../../scripts/huelle-kaufen.js';

  document.querySelectorAll('[data-teaser-huelle]').forEach((knopf) => {
    const ansage = knopf.parentElement.querySelector('[data-ansage]');
    knopf.addEventListener('click', () => huelleKaufen(knopf, knopf.dataset.modell, knopf.dataset.farbe, ansage));
  });
</script>
