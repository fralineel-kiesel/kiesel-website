---
// Die acht versteckten Details als Kacheln unter der Zoom-Demo, nach dem Artboard
// „Versteckte Zoom-Details“ (gen2.py: Ausschnitt crop(x, y, 8), Name und Zoom darunter).
// Klick = die Kamera fliegt hin (kamera-zoom.js). Wer ein Detail gefunden hat (selbst
// hingezoomt oder angeflogen), bekommt ein Häkchen, oben zählt „3 von 8 entdeckt“.
//   quelle: id der Szene (panoramaQuelle)   zoom: Zoom der Vorschau und des Flugs
//   hinweis: Satz unter dem Titel
import { ZOOM_TARGETS } from '../../lib/kiesel-draw/ausschnitt.js';
import { panoramaAnsicht } from '../../lib/kiesel-draw/scene.js';
import Icon from '../Icon.astro';

const { quelle, zoom, hinweis } = Astro.props;
---
<div class="details">
  <div class="kopf">
    <div>
      <h3 class="t-3">Acht versteckte Details</h3>
      <p class="t-muted">{hinweis}</p>
    </div>
    <p class="zaehler t-small" data-entdeckt>0 von {ZOOM_TARGETS.length} entdeckt</p>
  </div>
  <ul class="kacheln">
    {ZOOM_TARGETS.map(([name, x, y], i) => (
      <li>
        <button type="button" class="kachel" data-detail={i}>
          <span class="bild" set:html={panoramaAnsicht(quelle, { zoom, cx: x, cy: y })} />
          <span class="unter">
            <span class="name">{name}</span>
            <span class="zoom t-small">
              <span class="gefunden"><Icon name="check" size={16} /><span class="vh">entdeckt,</span></span>
              {zoom}x
            </span>
          </span>
        </button>
      </li>
    ))}
  </ul>
</div>

<style>
  .details { margin-top: var(--space-7); }
  .kopf { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-5); }
  .kopf p { margin-top: var(--space-1); }
  .zaehler {
    align-self: flex-start;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .kacheln {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kachel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    text-align: left;
    cursor: zoom-in;
  }
  .bild {
    display: block;
    width: 100%;
    aspect-ratio: 1.6;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--stage);
  }
  .bild :global(svg) { width: 100%; height: 100%; }
  .kachel:hover .bild { border-color: var(--muted); }
  .kachel:focus-visible { outline: none; }
  .kachel:focus-visible .bild { outline: 3px solid var(--accent); outline-offset: 3px; }
  .unter { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2); }
  .name { font-family: var(--body); font-size: var(--fs-small); font-weight: 600; line-height: 1.3; }
  .zoom { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--muted); font-variant-numeric: tabular-nums; }
  .gefunden { display: none; color: var(--accent); }
  .kachel[data-gefunden] .gefunden { display: inline-flex; }
  .kachel[data-gefunden] .bild { border-color: var(--accent); }

  @media (min-width: 900px) {
    .kopf { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .zaehler { align-self: auto; }
    .kacheln { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); }
    .name { font-size: var(--fs-text); }
  }
</style>
