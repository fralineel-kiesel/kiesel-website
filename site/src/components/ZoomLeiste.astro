---
// Zoom-Leiste aus Glas (0.5 · 1 · 3x · 10), liegt auf dem Kamerabild.
// Die gewählte Stufe zeigt ein „x“ dahinter, wie in der Kamera-App.
// Nur noch im Zoom-Teaser der Startseite. Die Kamera-Demos der Modellseiten haben seit
// Etappe 5 die stufenlose ZoomSkala (components/modell/).
const { stufen = ['0.5', '1', '3', '10'], aktiv = '3', label = 'Zoomstufe' } = Astro.props;
---
<div class="zoom-leiste" role="group" aria-label={label}>
  {stufen.map((s) => (
    <button type="button" aria-pressed={s === aktiv ? 'true' : 'false'} data-stufe={s}>
      <span class="zahl">{s}</span><span class="x" aria-hidden="true">x</span><span class="vh">-fach</span>
    </button>
  ))}
</div>

<style>
  .zoom-leiste {
    display: inline-flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border-radius: var(--radius-full);
    background: var(--glass);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  button {
    min-width: 44px;
    height: 44px;
    padding: 0 10px;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--glass-ink);
    font-family: var(--body);
    font-size: 14px;
    font-weight: 600;
  }
  button[aria-pressed="true"] { background: var(--glass-on); color: var(--glass-on-ink); }
  /* Das „x“ nur bei der gewählten Stufe zeigen */
  button[aria-pressed="false"] .x { display: none; }
</style>

<script>
  document.querySelectorAll('.zoom-leiste').forEach((leiste) => {
    leiste.addEventListener('click', (e) => {
      const knopf = e.target.closest('button');
      if (!knopf) return;
      leiste.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', b === knopf ? 'true' : 'false'));
      // Andere Teile der Seite können auf die Wahl hören (der Zoom-Teaser)
      leiste.dispatchEvent(new CustomEvent('kiesel:zoom', { bubbles: true, detail: { stufe: Number(knopf.dataset.stufe) } }));
    });
  });
</script>
