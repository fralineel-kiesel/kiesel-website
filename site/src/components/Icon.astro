---
// Strich-Icons aus design/generator/gen2.py (ICONS): 24er-Raster, Strich 1.8, Farbe = Textfarbe.
// Verwendung: <Icon name="bag" size={20} />
// Icons sind Dekoration (aria-hidden). Die Bedeutung steht immer im Text oder aria-label daneben.
const PFADE = {
  bag: 'M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z M9 8V6.5a3 3 0 0 1 6 0V8',
  down: 'M6 9l6 6 6-6',
  up: 'M6 15l6-6 6 6',
  arrow: 'M5 12h14 M13 6l6 6-6 6',
  rotate: 'M3.5 12a8.5 8.5 0 0 1 14.8-5.7 M18.6 2.8v3.8h-3.8 M20.5 12a8.5 8.5 0 0 1-14.8 5.7 M5.4 21.2v-3.8h3.8',
  menu: 'M4 7h16 M4 12h16 M4 17h16',
  close: 'M6 6l12 12 M18 6L6 18',
  plus: 'M12 5v14 M5 12h14',
  minus: 'M5 12h14',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  moon: 'M19.5 14.5A7.5 7.5 0 1 1 9.5 4.5a6 6 0 0 0 10 10Z',
  shield: 'M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3Z M9 12l2 2 4-4',
  dot: 'M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0-8 0',
  swap: 'M8 7l-4 5 4 5 M16 7l4 5-4 5',
};

const { name, size = 20, class: klasse } = Astro.props;
if (!PFADE[name]) throw new Error(`Icon "${name}" gibt es nicht.`);
---
<svg class:list={['icon', klasse]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={PFADE[name]} />
</svg>

<style>
  .icon {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
