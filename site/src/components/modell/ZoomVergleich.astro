---
// Zoom-Vergleich auf /kiesel-1-pro/ („3x Tele. Echt optisch.“, Artboard „Modellseite Kiesel 1 Pro“).
// Links der Kiesel 1 (nur digital, wird unscharf), rechts der Pro (Tele-Linse ab 3x).
//
// Aufbau: Drei gleich grosse Ebenen liegen übereinander, alle zeigen dieselbe Szene (einmal
// gezeichnet, per <use> wiederholt): Hauptkamera und Tele des Pro, darüber der Kiesel 1,
// den clip-path nur bis zur Trennlinie zeigt. Zoom, Linsenwechsel und die versteckten
// Details macht kamera-zoom.js, hier steht nur die Trennlinie. Skala, Linsen-Leiste,
// Zähler, Fokusring und Vorschaubilder wie im Artboard „Funktionen“ („Such das Gipfelkreuz“).
// Die Trennlinie steuert ein echtes <input type="range">: Damit funktionieren Pfeiltasten,
// Pos1/Ende und Screenreader von selbst. Maus und Finger bedienen dazu die ganze Bildfläche.
import Schalter from '../Schalter.astro';
import Icon from '../Icon.astro';
import GlasChip from '../GlasChip.astro';
import ZoomSkala from './ZoomSkala.astro';
import LinsenLeiste from './LinsenLeiste.astro';
import FokusRing from './FokusRing.astro';
import FundZaehler from './FundZaehler.astro';
import KameraFunde from './KameraFunde.astro';
import { panoramaQuelle, panoramaAnsicht } from '../../lib/kiesel-draw/index.js';
import { STUFEN, LINSEN } from '../../data/kamera.js';

// Anfangs 5x wie im Artboard: crop(756, 246, 5)
const START = { zoom: 5, cx: 756, cy: 246 };
const quelle = panoramaQuelle();
const ebene = () => panoramaAnsicht(quelle.id, START);
---
<div class="zoom-vergleich" data-zoom-vergleich data-linse="tele">
  <Fragment set:html={quelle.svg} />
  <div class="fenster" data-fenster style="--pos: 50%; --anteil: 0.5">
    <div class="ebene" data-ebene="haupt" set:html={ebene()} />
    <div class="ebene" data-ebene="tele" set:html={ebene()} />
    <div class="ebene k1" data-ebene="k1" set:html={ebene()} />
    <span class="vh" role="img" aria-label="Alpenpanorama bei 5x: links Kiesel 1 digital und unscharf, rechts Kiesel 1 Pro mit Tele scharf" data-bildtext></span>
    <FokusRing />
    <span class="chip-links"><GlasChip><span class="lang" data-text="k1">Kiesel 1 · 5x digital</span><span class="kurz" data-kurz="k1">Kiesel 1 · 5x</span></GlasChip></span>
    <span class="chip-rechts"><GlasChip>
      <span class="linsen" aria-hidden="true" title="Aktive Linse"><span class="punkt haupt"></span><span class="punkt tele"></span></span>
      <span class="lang" data-text="pro">Kiesel 1 Pro · 5x mit Tele</span><span class="kurz" data-kurz="pro">Pro · 5x Tele</span>
    </GlasChip></span>
    <span class="chip-zaehler"><FundZaehler /></span>
    <div class="linie" aria-hidden="true"><span class="griff"><Icon name="swap" size={22} /></span></div>
    <input
      class="regler"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label="Trennlinie: links Kiesel 1, rechts Kiesel 1 Pro"
      aria-valuetext="Mitte"
      data-regler
    />
  </div>
  <ZoomSkala max={10} stufen={STUFEN.pro} tele={3} label="Zoom" />
  <LinsenLeiste abschnitte={LINSEN.pro} />
  <div class="vergleich-zeile">
    <Schalter an={true} data-vergleich-schalter>Mit Kiesel 1 vergleichen</Schalter>
  </div>
  <KameraFunde quelle={quelle.id} />
  <p class="vh" aria-live="polite" data-ansage></p>
</div>

<style>
  .fenster {
    position: relative;
    height: 360px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--stage);
    /* Senkrecht wischen scrollt weiter die Seite, waagrecht bedient den Regler */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
  }
  /* Jede Ebene ist rundherum --rand grösser als das Fenster, und das SVG zeichnet über
     seinen Rand hinaus weiter (overflow: visible). Die Unschärfe (CSS blur) franst so nur
     ausserhalb des sichtbaren Bereichs aus, statt am Bildrand hell oder dunkel zu werden. */
  .fenster { --rand: 40px; }
  .ebene { position: absolute; inset: calc(-1 * var(--rand)); padding: var(--rand); transform-origin: 50% 50%; }
  .ebene :global(svg) { width: 100%; height: 100%; overflow: visible; }
  /* Kiesel 1 nur bis zur Trennlinie. --anteil = Lage der Linie als Zahl 0…1 (--pos in %),
     umgerechnet auf die grössere Ebene */
  .k1 { clip-path: inset(0 calc(100% - var(--rand) - (100% - 2 * var(--rand)) * var(--anteil)) 0 0); }
  .chip-links, .chip-rechts, .chip-zaehler { position: absolute; top: var(--space-3); z-index: 2; pointer-events: none; }
  .chip-zaehler { top: auto; right: var(--space-3); bottom: var(--space-3); }
  .chip-links { left: var(--space-3); }
  .chip-rechts { right: var(--space-3); }
  /* Auf dem Handy wären beide Chips zusammen breiter als das Bild: Kurzfassung */
  .lang { display: none; }

  /* Welche Linse arbeitet: links Hauptkamera, rechts Tele, wie hinten am Pro */
  .linsen { display: inline-flex; gap: 4px; margin-right: -2px; }
  .punkt {
    position: relative;
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--glass-ink);
    border-radius: var(--radius-full);
    opacity: 0.55;
    transition: background-color 0.2s, opacity 0.2s;
  }
  [data-linse="haupt"] .punkt.haupt, [data-linse="tele"] .punkt.tele { background: var(--glass-ink); opacity: 1; }
  /* Beim Wechsel läuft ein Ring von der neuen Linse weg. Die Regel greift erst, wenn
     data-linse wechselt, darum startet die Animation genau dann (auch mehrmals). */
  .punkt::after {
    content: '';
    position: absolute;
    inset: -1.5px;
    border: 1.5px solid var(--glass-ink);
    border-radius: inherit;
    opacity: 0;
  }
  [data-linse="haupt"] .punkt.haupt::after { animation: puls-haupt 0.6s ease-out; }
  [data-linse="tele"] .punkt.tele::after { animation: puls-tele 0.6s ease-out; }
  /* Zwei gleiche Animationen mit zwei Namen: sonst startet sie beim Hin- und Herwechseln nicht neu */
  @keyframes puls-haupt { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(2.6); } }
  @keyframes puls-tele { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(2.6); } }
  @media (prefers-reduced-motion: reduce) {
    .punkt::after { animation: none !important; }
    .punkt { transition: none; }
  }

  .linie {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 2;
    width: 2px;
    margin-left: -1px;
    background: var(--glass-on);
    pointer-events: none;
  }
  .griff {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--glass-on);
    color: var(--glass-on-ink);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.25);
  }
  /* Der Regler selbst ist unsichtbar (liegt über der Fläche); sein Fokus erscheint am Griff */
  .regler {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .regler:focus-visible ~ .linie .griff,
  .fenster:has(.regler:focus-visible) .griff {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .fenster[data-allein] { cursor: default; }
  .fenster[data-allein] .k1, .fenster[data-allein] .linie, .fenster[data-allein] .chip-links { display: none; }

  .vergleich-zeile { display: flex; justify-content: flex-end; margin-top: var(--space-4); }

  @media (min-width: 900px) {
    .fenster { height: 560px; border-radius: calc(var(--radius-l) + 4px); }
    .lang { display: inline; }
    .kurz { display: none; }
    .chip-links { left: var(--space-5); top: var(--space-5); }
    .chip-rechts { right: var(--space-5); top: var(--space-5); }
    .chip-zaehler { right: var(--space-5); bottom: var(--space-5); }
  }
</style>

<script>
  import { starteKamera, zahl } from '../../scripts/kamera-zoom.js';

  // Texte je Zoom. Kiesel 1: bis 1x optisch (variable Linse), dann digital, max. 5x.
  // Pro: bis 1x optisch, bis 3x digital aus der Hauptkamera, ab 3x Tele.
  const TEXT = {
    k1: (z) => (z <= 1 ? `Kiesel 1 · ${zahl(z)}x optisch` : z > 5 ? 'Kiesel 1 · max. 5x digital' : `Kiesel 1 · ${zahl(z)}x digital`),
    pro: (z) => (z <= 1 ? `Kiesel 1 Pro · ${zahl(z)}x optisch` : z < 3 ? `Kiesel 1 Pro · ${zahl(z)}x digital` : z === 3 ? 'Kiesel 1 Pro · 3x Tele' : `Kiesel 1 Pro · ${zahl(z)}x mit Tele`),
  };
  const KURZ = {
    k1: (z) => (z > 5 ? 'Kiesel 1 · max. 5x' : `Kiesel 1 · ${zahl(z)}x`),
    pro: (z) => (z < 3 ? `Pro · ${zahl(z)}x` : `Pro · ${zahl(z)}x Tele`),
  };

  document.querySelectorAll('[data-zoom-vergleich]').forEach((wurzel) => {
    const fenster = wurzel.querySelector('[data-fenster]');
    const regler = wurzel.querySelector('[data-regler]');
    const feld = (sel) => ({ k1: wurzel.querySelector(`[${sel}="k1"]`), pro: wurzel.querySelector(`[${sel}="pro"]`) });
    const text = feld('data-text'), kurz = feld('data-kurz');
    const bildtext = wurzel.querySelector('[data-bildtext]');

    starteKamera(wurzel, {
      max: 10,
      start: 5,
      blick: [756, 246],
      zielZoom: 8,
      beschrifte: ({ z, linse }) => {
        for (const m of ['k1', 'pro']) {
          text[m].textContent = TEXT[m](z);
          kurz[m].textContent = KURZ[m](z);
        }
        const k1 = z <= 1 ? 'scharf' : z <= 2 ? 'leicht weich' : 'unscharf';
        const pro = linse === 'tele' ? 'Tele-Linse, scharf' : z <= 1 ? 'scharf' : z <= 2 ? 'leicht weich' : 'unscharf';
        bildtext.setAttribute('aria-label', fenster.hasAttribute('data-allein')
          ? `Alpenpanorama bei ${zahl(z)}x: Kiesel 1 Pro, ${pro}`
          : `Alpenpanorama bei ${zahl(z)}x: links Kiesel 1, ${k1}; rechts Kiesel 1 Pro, ${pro}`);
        return `${zahl(z)}-fach, ${linse === 'tele' ? 'Tele-Linse' : 'Hauptkamera'}`;
      },
    });

    // ── Trennlinie ──
    function setze(wert) {
      const v = Math.min(100, Math.max(0, Math.round(wert)));
      regler.value = String(v);
      fenster.style.setProperty('--pos', `${v}%`);
      fenster.style.setProperty('--anteil', String(v / 100));
      regler.setAttribute('aria-valuetext', v === 50 ? 'Mitte' : `${v} % Kiesel 1, ${100 - v} % Kiesel 1 Pro`);
    }
    regler.addEventListener('input', () => setze(+regler.value));
    const ausX = (x) => {
      const r = fenster.getBoundingClientRect();
      return ((x - r.left) / r.width) * 100;
    };

    // Maus: sofort ziehen. Finger/Stift: erst ziehen, wenn die Bewegung waagrecht ist,
    // sonst gehört die Geste dem Scrollen (touch-action: pan-y). Antippen setzt die Linie.
    let zug = null;
    fenster.addEventListener('pointerdown', (e) => {
      if (fenster.hasAttribute('data-allein') || e.button !== 0) return;
      zug = { id: e.pointerId, x: e.clientX, y: e.clientY, aktiv: e.pointerType === 'mouse' };
      if (zug.aktiv) {
        fenster.setPointerCapture(e.pointerId);
        setze(ausX(e.clientX));
        e.preventDefault(); // kein Text markieren
      }
    });
    fenster.addEventListener('pointermove', (e) => {
      if (!zug || e.pointerId !== zug.id) return;
      if (!zug.aktiv) {
        const dx = Math.abs(e.clientX - zug.x), dy = Math.abs(e.clientY - zug.y);
        if (dx > 6 && dx > dy) {
          zug.aktiv = true;
          fenster.setPointerCapture(e.pointerId);
        } else if (dy > 6) {
          zug = null; // senkrecht: der Browser scrollt
          return;
        } else return;
      }
      setze(ausX(e.clientX));
    });
    const ende = (e) => {
      if (!zug || e.pointerId !== zug.id) return;
      // Antippen ohne Bewegung: Linie dorthin
      if (!zug.aktiv && e.type === 'pointerup') setze(ausX(e.clientX));
      zug = null;
    };
    fenster.addEventListener('pointerup', ende);
    fenster.addEventListener('pointercancel', ende);

    // ── Vergleich an/aus ──
    wurzel.querySelector('[data-vergleich-schalter]').addEventListener('kiesel:schalter', (e) => {
      fenster.toggleAttribute('data-allein', !e.detail.an);
      regler.disabled = !e.detail.an;
    });
  });
</script>
