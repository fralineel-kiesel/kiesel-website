---
// Platzhalter für ein Handy, bis der Zeichen-Motor (Etappe 2) die echten Zeichnungen liefert.
// Stimmt im Seitenverhältnis: Kiesel 1 = 58.6 × 123.8 mm, Pro = 64.2 × 131.5 mm.
import { FARBEN } from '../data/farben.js';
import { MODELLE } from '../data/modelle.js';

const { modell = 'pro', farbe, hoehe = 180 } = Astro.props;
const f = FARBEN[farbe ?? MODELLE[modell].farbe];
const breite = Math.round(hoehe * (modell === 'pro' ? 64.2 / 131.5 : 58.6 / 123.8));
---
<span class="handy" aria-hidden="true"
  style={`--b: ${breite}px; --h: ${hoehe}px; --rahmen: ${f.frame}; --hi: ${f.hi}; --lo: ${f.lo}`}>
  <span class="glas"><span class="insel"></span></span>
</span>

<style>
  .handy {
    display: block;
    flex-shrink: 0;
    width: var(--b);
    height: var(--h);
    padding: calc(var(--b) * 0.035);
    border-radius: calc(var(--b) * 0.16);
    background: linear-gradient(90deg, var(--lo), var(--hi) 5%, var(--rahmen) 18%, var(--rahmen) 82%, var(--hi) 95%, var(--lo));
  }
  .glas {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--b) * 0.13);
    background: linear-gradient(160deg, #2A3642, #0C1116 70%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: center;
  }
  /* Dynamic Island oben in der Mitte */
  .insel {
    width: 30%;
    height: calc(var(--b) * 0.09);
    margin-top: calc(var(--b) * 0.07);
    border-radius: var(--radius-full);
    background: #000000;
  }
</style>
