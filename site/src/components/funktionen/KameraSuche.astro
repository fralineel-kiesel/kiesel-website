---
// „Such das Gipfelkreuz.“ auf /funktionen/ (Artboard „Funktionen“, gen3.py, Abschnitt kamera):
// Alpenpanorama mit der Kamera des Pro, ohne Vergleich. Oben links die Linse und der Zoom,
// oben rechts der Zähler, um das gefundene Detail der Fokusring. Darunter Zoom-Skala mit
// Tele-Strich, Linsen-Leiste und die acht Vorschaubilder.
// Nur hier gibt es die versteckten Details (ZoomBild mit details): tippen oder klicken schwenkt
// dorthin, ziehen verschiebt. Start bei 1x, damit es etwas zu suchen gibt.
import ZoomBild from '../modell/ZoomBild.astro';
import ZoomSkala from '../modell/ZoomSkala.astro';
import LinsenLeiste from '../modell/LinsenLeiste.astro';
import KameraFunde from './KameraFunde.astro';
import { panoramaQuelle } from '../../lib/kiesel-draw/index.js';
import { STUFEN, LINSEN, TELE_AB, MAX_ZOOM } from '../../data/kamera.js';

const quelle = panoramaQuelle(); // auch für die Vorschaubilder
---
<div class="kamera-suche" data-kamera data-kamera-suche>
  <Fragment set:html={quelle.svg} />
  <div class="bild"><ZoomBild modell="pro" start={1} blick={[760, 300]} details quelle={quelle} /></div>
  <ZoomSkala max={MAX_ZOOM.pro} stufen={STUFEN.pro} tele={TELE_AB} label="Zoom" />
  <LinsenLeiste abschnitte={LINSEN.pro} />
  <KameraFunde quelle={quelle.id} />
  <p class="vh" aria-live="polite" data-ansage></p>
</div>

<style>
  .bild { margin-top: var(--space-7); }
</style>
