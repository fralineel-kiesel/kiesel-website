---
// Die ganze Modellseite (/kiesel-1/ und /kiesel-1-pro/), Abschnitt für Abschnitt nach dem
// Artboard „Modellseite Kiesel 1 Pro“. Der Kiesel 1 bekommt sinngemäss dieselben Abschnitte,
// aber mit einer Kamera: statt des Tele-Vergleichs die einfache Zoom-Demo bis 5x.
//   modell: 'k1' | 'pro'
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kennzahlen from '../startseite/Kennzahlen.astro';
import ModellKopf from './ModellKopf.astro';
import ZoomVergleich from './ZoomVergleich.astro';
import ZoomDemo from './ZoomDemo.astro';
import MakroDemo from './MakroDemo.astro';
import AkkuStory from './AkkuStory.astro';
import AkkuFazit from './AkkuFazit.astro';
import FarbReihe from './FarbReihe.astro';
import Eckdaten from './Eckdaten.astro';
import KaufBox from './KaufBox.astro';
import { MODELLE } from '../../data/modelle.js';
import { akku } from '../../data/geraete.js';
import { WERTE } from '../../data/technik.js';

const W = WERTE;

const { modell } = Astro.props;
const m = MODELLE[modell];
const pro = modell === 'pro';
const beschreibung = pro
  ? `Kiesel 1 Pro: so gross wie das iPhone 13 mini, mit echtem ${WERTE.tele}x-Tele und ${akku('pro')}. Ein Fan-Konzept.`
  : `Kiesel 1: so gross wie das iPhone SE von 2016, mit ${akku('k1')} für den ganzen Tag. Ein Fan-Konzept.`;
---
<BaseLayout titel={m.name} beschreibung={beschreibung} unterleiste={modell}>
  <ModellKopf modell={modell} />

  <section class="abschnitt container" aria-label="Kennzahlen">
    <Kennzahlen zahlen={m.seite.kennzahlen} />
  </section>

  <section class="abschnitt container" id="kamera" aria-labelledby="kamera-titel">
    {pro ? (
      <>
        <h2 class="t-1" id="kamera-titel">{W.tele}x Tele. Echt optisch.</h2>
        <p class="t-lead t-muted unter">Links der Kiesel 1 bei {W.zoomDigital.k1}x, rein digital. Rechts der Pro, der bei {W.tele}x auf die Tele-Linse wechselt und bei {W.zoomDigital.k1}x noch aus einem scharfen Bild schneidet. Zieh den Regler und schau selbst.</p>
        <div class="demo"><ZoomVergleich /></div>
      </>
    ) : (
      <>
        <h2 class="t-1" id="kamera-titel">Eine Kamera. Alles drin.</h2>
        <p class="t-lead t-muted unter">Die variable Linse fährt stufenlos von 0.5x bis 1x, jeweils mit vollen {W.megapixel} MP. Darüber zoomt der Kiesel 1 digital bis {W.zoomDigital.k1}x, dann wird es weicher. Wer echtes Tele will, nimmt den Pro.</p>
        <div class="demo"><ZoomDemo /></div>
      </>
    )}
  </section>

  <section class="abschnitt container" aria-labelledby="makro-titel">
    <div class="makro">
      <div class="makro-text">
        <h2 class="t-1" id="makro-titel">Ganz nah dran.</h2>
        <p class="t-lead t-muted">{pro
          ? `Die Tele-Linse stellt schon ab rund ${W.nahfokusCm} cm scharf. Die Blume bleibt gross, der Hintergrund verschwimmt weich. Tipp aufs Bild, um den Fokus zu verschieben.`
          : 'Die Hauptkamera kann Makro: Blüte, Biene und Tautropfen ganz aus der Nähe. Tipp aufs Bild, um den Fokus zu verschieben.'}</p>
      </div>
      <MakroDemo modell={modell} />
    </div>
  </section>

  <div class="abschnitt" id="akku">
    <AkkuStory modell={modell} />
  </div>

  <section class="abschnitt container" aria-label="Akku im Vergleich">
    <AkkuFazit modell={modell} />
  </section>

  <section class="abschnitt container" id="farben" aria-labelledby="farben-titel">
    <h2 class="t-1" id="farben-titel">Fünf Farben.</h2>
    <div class="farben"><FarbReihe modell={modell} /></div>
  </section>

  <section class="abschnitt container" aria-labelledby={`eckdaten-${modell}`}>
    <Eckdaten modell={modell} />
  </section>

  <section class="abschnitt container" aria-label={`${m.name} kaufen`}>
    <KaufBox modell={modell} />
  </section>
</BaseLayout>

<style>
  /* Abstand zwischen den Abschnitten wie auf der Startseite: 64 px (Handy) bis 140 px (Desktop).
     Als Sprungziel (#kamera, #akku, #farben) steht der Inhalt knapp unter der Unterleiste. */
  .abschnitt {
    --abstand: clamp(var(--space-8), 10vw, var(--space-10));
    padding-top: var(--abstand);
    scroll-margin-top: calc(var(--space-2) - var(--abstand));
  }
  .unter { max-width: 680px; margin-top: var(--space-4); }
  .demo { margin-top: var(--space-5); }
  .makro { display: grid; gap: var(--space-5); }
  .makro-text { display: flex; flex-direction: column; gap: var(--space-4); }
  .farben { margin-top: var(--space-6); }

  @media (min-width: 900px) {
    .demo { margin-top: calc(var(--space-6) + var(--space-2)); }
    .makro { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-8); align-items: center; }
    .makro-text h2 { font-size: calc(var(--fs-1) * 0.875); }
    .makro-text { gap: calc(var(--space-4) + 2px); }
    .farben { margin-top: var(--space-7); }
  }
</style>
