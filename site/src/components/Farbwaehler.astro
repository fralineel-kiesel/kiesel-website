---
// Farbwähler mit den fünf Produktfarben.
// Technik: echte Radio-Knöpfe (<input type="radio">), nur optisch versteckt.
// Warum: Der Browser erledigt dann die Tastatur (Tab in die Gruppe, Pfeiltasten wechseln)
// und Screenreader sagen „Himmelblau, Optionsfeld, 1 von 5“. Das müssten wir sonst nachbauen.
//   name:    eindeutiger Name der Gruppe auf der Seite (Pflicht, wenn es mehrere gibt)
//   wert:    anfangs gewählte Farbe (Kennung wie 'sky-blue', siehe data/farben.js)
//   legende: Beschriftung; zeigeName: gewählte Farbe daneben anzeigen
//   groesse: Durchmesser des Farbpunkts (34 = 44 px Tippfläche, 28 auf dem Handy)
//   zeile:   Beschriftung nur für Screenreader, Farbname sichtbar rechts neben den Punkten
//            (z.B. auf der 3D-Bühne). Farben von aussen über --fw-ink (Text und Ring).
// Meldet jede Wahl als Ereignis „kiesel:farbe“ (detail.farbe = Kennung).
// Wert der Radio-Knöpfe = Kennung, angezeigt wird der Name aus der Textdatei.
import { FARBEN, FARB_IDS } from '../data/farben.js';
import { texte, spracheVon } from '../i18n/index.js';

const t = texte(spracheVon(Astro.url));
const { name = 'farbe', wert = 'sky-blue', legende = t.kaufen.farbe, zeigeName = true, groesse = 34, zeile = false, class: klasse } = Astro.props;
---
<fieldset class:list={['farbwaehler', { 'farbwaehler--zeile': zeile }, klasse]} style={`--punkt: ${groesse}px`} data-farbwaehler>
  {zeile
    ? <legend class="vh">{legende}</legend>
    : <legend class:list={[{ vh: !zeigeName }]}>{legende}{zeigeName && <>: <span data-farbname>{t.farben[wert]}</span></>}</legend>}
  <div class="punkte">
    {FARB_IDS.map((farbe) => (
      <label title={t.farben[farbe]}>
        <input class="vh" type="radio" name={name} value={farbe} checked={farbe === wert} />
        <span class="ring"><span class="punkt" style={`--farbe: ${FARBEN[farbe].frame}`}></span></span>
        <span class="vh">{t.farben[farbe]}</span>
      </label>
    ))}
  </div>
  {/* Der Screenreader sagt die gewählte Farbe schon beim Radio-Knopf, darum aria-hidden */}
  {zeile && zeigeName && <span class="name" aria-hidden="true" data-farbname>{t.farben[wert]}</span>}
</fieldset>

<style>
  .farbwaehler { border: 0; margin: 0; padding: 0; min-width: 0; color: var(--fw-ink, var(--ink)); }
  legend { padding: 0; margin-bottom: var(--space-3); font-size: 15px; font-weight: 600; }
  .punkte { display: flex; flex-wrap: wrap; gap: 6px; }
  label { position: relative; display: block; cursor: pointer; }
  .ring {
    display: block;
    width: calc(var(--punkt) + 10px);
    height: calc(var(--punkt) + 10px);
    padding: 3px;
    border: 2px solid transparent;
    border-radius: var(--radius-full);
  }
  .punkt {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    background: var(--farbe);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
  }
  input:checked + .ring { border-color: var(--fw-ink, var(--ink)); }
  label:hover input:not(:checked) + .ring { border-color: var(--fw-hover, var(--line)); }
  input:focus-visible + .ring { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Zeile: Punkte und Name nebeneinander (Richtung von aussen umstellbar) */
  .farbwaehler--zeile {
    display: flex;
    flex-direction: var(--fw-richtung, row);
    align-items: center;
    gap: var(--fw-abstand, var(--space-2));
  }
  .farbwaehler--zeile .punkte { gap: 2px; flex-wrap: nowrap; }
  .name { min-width: 96px; font-size: 15px; font-weight: 600; }
</style>

<script>
  // Gewählten Farbnamen in der Beschriftung nachführen und ein Ereignis melden.
  // Den Namen in der Sprache der Seite trägt schon das title des Labels.
  document.querySelectorAll('[data-farbwaehler]').forEach((gruppe) => {
    gruppe.addEventListener('change', (e) => {
      const name = e.target.closest('label').title;
      gruppe.querySelectorAll('[data-farbname]').forEach((anzeige) => { anzeige.textContent = name; });
      gruppe.dispatchEvent(new CustomEvent('kiesel:farbe', { bubbles: true, detail: { farbe: e.target.value } }));
    });
  });
</script>
