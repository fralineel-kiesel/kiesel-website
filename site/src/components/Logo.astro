---
// Das Kiesel-Logo: ein Kiesel (Farbe --ink) mit zwei Adern (Farbe --accent).
// Formen aus design/generator/lib.py (PEB, V1, V2).
// Die Adern werden mit einem clipPath auf die Form des Kiesels zugeschnitten.
// Jede clipPath-ID muss auf der Seite eindeutig sein, darum zählen wir mit.
const { size = 30 } = Astro.props;

const KIESEL = 'M54 18C79 17 96 31 95 52C94 72 76 84 50 84C24 84 5 73 5 53C5 33 27 19 54 18Z';
const ADER_1 = 'M-4 70C26 62 56 50 104 34';
const ADER_2 = 'M-4 80C30 72 64 60 104 46';

// Zähler pro Build: Astro rendert die Seiten nacheinander, die Zahl bleibt eindeutig.
globalThis.__kieselLogo = (globalThis.__kieselLogo ?? 0) + 1;
const id = `kiesel-logo-${globalThis.__kieselLogo}`;
---
<svg class="logo" width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs><clipPath id={id}><path d={KIESEL} /></clipPath></defs>
  <path class="kiesel" d={KIESEL} />
  <g clip-path={`url(#${id})`}>
    <path class="ader ader-1" d={ADER_1} />
    <path class="ader ader-2" d={ADER_2} />
  </g>
</svg>

<style>
  .logo { flex-shrink: 0; }
  .kiesel { fill: var(--ink); }
  .ader { fill: none; stroke: var(--accent); stroke-linecap: round; }
  .ader-1 { stroke-width: 7; }
  .ader-2 { stroke-width: 2.2; opacity: 0.7; }
</style>
